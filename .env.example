GMAIL_QUERY=in:inbox has:attachment filename:pdf
PAGE_SIZE=50
# Sender addresses and optional initial date are configured in config.json.
# Runs once, processes every page, then exits. No polling interval is used.
# Optional full path if SumatraPDF is not installed in a standard location:
# SUMATRA_PDF=C:\Program Files\SumatraPDF\SumatraPDF.exe
