GMAIL_QUERY=in:inbox has:attachment filename:pdf
PAGE_SIZE=50
# Sender addresses and optional initial date are configured in config.json.
# Runs once, processes every page, then exits. No polling interval is used.
# Optional full path if SumatraPDF is not installed in a standard location:
# SUMATRA_PDF=C:\Program Files\SumatraPDF\SumatraPDF.exe
# Signature verification is required before printing. Run Setup Signature Verification.cmd once.
# Optional overrides for non-standard Python or trusted-root locations:
# SIGNATURE_PYTHON=C:\path\to\python.exe
# SIGNATURE_TRUST_DIR=C:\path\to\trusted-ca-certificates
# Permit legacy SHA-1 only when explicitly enabled. Trust/revocation/integrity remain required.
SIGNATURE_ALLOW_LEGACY_SHA1=false
