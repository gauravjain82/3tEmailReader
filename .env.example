GMAIL_QUERY=in:inbox has:attachment filename:pdf
PAGE_SIZE=50
# Sender addresses and optional initial date are configured in config.json.
# Runs once, processes every page, then exits.
# Printing uses SumatraPDF, without digital signature verification.
# Optional full path for a nonstandard SumatraPDF installation:
# SUMATRA_PDF=C:\Program Files\SumatraPDF\SumatraPDF.exe

# Optional rejection-PDF extraction through Vertex AI. Local parsing remains the default.
# Choose a Gemini Flash model ID available in your project/location.
# REJECTION_GEMINI_MODEL=gemini-3-flash-preview
# High-resolution PDF reading is the default; uses more media tokens.
# REJECTION_GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
# GOOGLE_CLOUD_LOCATION=global
# For Application Default Credentials or an existing service-account file:
# VERTEX_AUTH_MODE=adc
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/vertex-service-account.json
# Alternatively, use a Vertex-compatible Google Cloud API key:
# VERTEX_AUTH_MODE=api-key
# VERTEX_API_KEY=put-your-key-only-in-the-local-env-file
